---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteFilters from "../../components/NoteFilters.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { site } from "../../config/site";
import { getCategoryLabel, getFormatLabel, getNoteDate, getNotePath } from "../../lib/notes";

const notes = (await getCollection("notes", ({ data }) => !data.draft && data.language === "en")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  lang="en"
  title={`Notes — ${site.publicName}`}
  description="Notes by Luis Coelho Ramos on frontier science, technology, business, and reading."
  alternatePath="/pt/notas/"
>
  <SiteHeader lang="en" alternatePath="/pt/notas/" current="notes" />
  <main id="content" class="shell archive">
    <header class="archive-heading">
      <p class="eyebrow">Applied Frontier</p>
      <h1>Notes</h1>
      <p>Essays, analyses, and field notes on science, execution, and the ideas shaping my work.</p>
    </header>
    <NoteFilters lang="en" />
    <div class="archive-list" id="note-list">
      {
        notes.map((note) => (
            <article class="archive-item" data-note-category={note.data.category}>
              <p>{getCategoryLabel(note)} · {getFormatLabel(note)}</p>
              <h2><a href={getNotePath(note)}>{note.data.title}</a></h2>
              <p>{note.data.description}</p>
              <time datetime={note.data.publishedAt.toISOString()}>
                {getNoteDate(note)}
              </time>
            </article>
          ))
      }
      <p class="empty-state" data-note-empty-state hidden={notes.length > 0}>The first notes are being prepared.</p>
    </div>
  </main>
</BaseLayout>
