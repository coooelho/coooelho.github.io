---
import NotesPage from "../../../components/NotesPage.astro";

export function getStaticPaths() {
  return [
    { params: { section: "research" }, props: { category: "research" as const } },
    { params: { section: "business" }, props: { category: "business" as const } },
  ];
}

interface Props {
  category: "research" | "business";
}

const { category } = Astro.props;
---

<NotesPage lang="en" category={category} />
