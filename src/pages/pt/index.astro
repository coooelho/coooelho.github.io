---
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/luis-coelho-ramos-portrait.jpg";

const description =
  "Luis Coelho Ramos é fundador e co-CEO do PedeAqui e vice-presidente de Estratégia e Parcerias Internacionais do ICTQ Foton.";
---

<BaseLayout
  lang="pt-BR"
  title={`${site.publicName} — ${site.publication.pt}`}
  description={description}
  alternatePath="/"
>
  <header class="site-header shell">
    <a class="brand" href="/pt/">{site.publicName}</a>
    <nav class="primary-nav" aria-label="Navegação principal">
      <a href="/pt/notas/">Notas</a>
      <a href="/pt/notas/leituras/">Leituras</a>
    </nav>
    <nav class="language-nav" aria-label="Idioma">
      <a href="/pt/" aria-current="page">PT</a>
      <span aria-hidden="true">/</span>
      <a href="/" lang="en">EN</a>
    </nav>
  </header>
  <main id="content" class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow">IA · Tecnologias quânticas · Relações internacionais</p>
      <h1>Transformando ciência de fronteira em decisões relevantes.</h1>
      <p class="intro">
        Atuo onde tecnologia emergente encontra execução: na coliderança do
        PedeAqui, uma plataforma de IA para operações de restaurantes, e nas
        relações internacionais do ICTQ Foton, instituto brasileiro de ciência e
        tecnologia quântica.
      </p>
      <div class="roles">
        <article>
          <span>Construindo</span>
          <h2>Fundador e co-CEO do PedeAqui</h2>
        </article>
        <article>
          <span>Internacional</span>
          <h2>Vice-presidente de Estratégia e Parcerias Internacionais do ICTQ Foton</h2>
        </article>
      </div>
      <NewsletterSignup lang="pt" />
    </div>
    <figure class="hero-portrait">
      <Image
        src={portrait}
        alt="Retrato de Luis Coelho Ramos usando terno escuro e gravata azul, sorrindo diante de um fundo cinza."
        widths={[480, 720, 1023]}
        sizes="(max-width: 800px) 88vw, 38vw"
        loading="eager"
      />
    </figure>
  </main>
</BaseLayout>
