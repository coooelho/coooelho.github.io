---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NoteFilters from "../../../components/NoteFilters.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { site } from "../../../config/site";

const notes = (await getCollection("notes", ({ data }) => !data.draft && data.language === "pt-BR")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  lang="pt-BR"
  title={`Notas — ${site.publicName}`}
  description="Notas de Luis Coelho Ramos sobre ciência de fronteira, tecnologia, negócios e leituras."
  alternatePath="/notes/"
>
  <SiteHeader lang="pt-BR" alternatePath="/notes/" current="notes" />
  <main id="content" class="shell archive">
    <header class="archive-heading">
      <p class="eyebrow">Fronteira Aplicada</p>
      <h1>Notas</h1>
      <p>Ensaios, análises e registros de campo sobre ciência, execução e as ideias que orientam meu trabalho.</p>
    </header>
    <NoteFilters lang="pt-BR" />
    <div class="archive-list" id="note-list">
      {
        notes.map((note) => (
            <article class="archive-item" data-note-category={note.data.category}>
              <p>{note.data.category} · {note.data.format}</p>
              <h2>{note.data.title}</h2>
              <p>{note.data.description}</p>
              <time datetime={note.data.publishedAt.toISOString()}>
                {note.data.publishedAt.toLocaleDateString("pt-BR", { dateStyle: "long" })}
              </time>
            </article>
          ))
      }
      <p class="empty-state" data-note-empty-state hidden={notes.length > 0}>As primeiras notas estão sendo preparadas.</p>
    </div>
  </main>
</BaseLayout>
