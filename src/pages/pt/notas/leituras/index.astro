---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { site } from "../../../../config/site";

const entries = (await getCollection("reading")).sort(
  (a, b) => b.data.publicationYear - a.data.publicationYear || a.data.title.localeCompare(b.data.title),
);

const typeLabel = {
  book: "Livro",
  paper: "Artigo científico",
  article: "Artigo",
  "conference-paper": "Trabalho de conferência",
} as const;
const statusLabel = { reading: "Em leitura", finished: "Concluído", reference: "Catalogado" } as const;
const publicationLabel = (year: number, approximate: boolean) => {
  const prefix = approximate ? "c. " : "";
  return year < 0 ? `${prefix}${Math.abs(year)} a.C.` : `${prefix}${year}`;
};
const finishedCount = entries.filter(({ data }) => data.status === "finished").length;
const creatorText = (creators: string[]) =>
  creators.length > 8 ? `${creators.slice(0, 2).join(", ")} e mais ${creators.length - 2}` : creators.join(", ");
---

<BaseLayout
  lang="pt-BR"
  title={`Leituras — ${site.publicName}`}
  description="Livros, artigos científicos e textos longos que influenciaram o pensamento e o trabalho de Luis Coelho Ramos."
  alternatePath="/notes/reading/"
>
  <header class="site-header shell">
    <a class="brand" href="/pt/">{site.publicName}</a>
    <nav class="primary-nav" aria-label="Navegação principal">
      <a href="/pt/notas/">Notas</a>
      <a href="/pt/notas/leituras/" aria-current="page">Leituras</a>
    </nav>
    <nav class="language-nav" aria-label="Idioma">
      <a href="/pt/notas/leituras/" aria-current="page">PT</a><span aria-hidden="true">/</span><a href="/notes/reading/" lang="en">EN</a>
    </nav>
  </header>
  <main id="content" class="shell archive reading-archive">
    <header class="archive-heading">
      <p class="eyebrow">Notas · Leituras</p>
      <h1>Biblioteca de leituras</h1>
      <p>
        Obras que li anteriormente e pretendo revisitar. À medida que eu concluir cada releitura, publicarei aqui
        minha nota ou resenha e atualizarei seu status.
      </p>
      <p class="archive-summary">{entries.length} obras no catálogo · {finishedCount} releituras concluídas</p>
    </header>
    <div class="reading-types" aria-label="Tipos de leitura">
      <div><strong>Livros</strong><span>Argumentos que merecem ser revisitados</span></div>
      <div><strong>Artigos científicos</strong><span>Evidências e pesquisa de fronteira</span></div>
      <div><strong>Artigos</strong><span>Seleção de textos longos</span></div>
    </div>
    <div class="archive-list">
      {
        entries.length > 0 ? (
          entries.map((entry) => (
            <article class="archive-item">
              <p>
                {typeLabel[entry.data.type]} · {statusLabel[entry.data.status]} · {publicationLabel(entry.data.publicationYear, entry.data.publicationYearApproximate)}
              </p>
              <div class="reading-entry">
                <h2>{entry.data.titlePt ?? entry.data.title}</h2>
                <p class="reading-creator">
                  {entry.data.creatorRole === "editor" && "Organização: "}{creatorText(entry.data.creators)}
                </p>
                <p>{entry.data.description.pt}</p>
                {entry.data.venue && <p class="reading-venue">{entry.data.venue}</p>}
                <a href={entry.data.sourceUrl} rel="noopener noreferrer">
                  Ver fonte original <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        ) : (
          <p class="empty-state">As notas de leitura aparecerão aqui conforme a coleção for organizada.</p>
        )
      }
    </div>
  </main>
</BaseLayout>
