---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { site } from "../../config/site";
import { withBase } from "../../lib/paths";

const description =
  "The journey of Luis Coelho Ramos across business operations, studies in physics, international experience, quantum technologies, and applied AI.";

const chapters = [
  {
    phase: "Early experience",
    title: "Learning how organizations actually work.",
    text: "My first professional lessons came from a family business. Working close to customers, inventory, maintenance, and day-to-day operations taught me that every strategy eventually meets a process, a constraint, and a person responsible for making it work.",
  },
  {
    phase: "Scientific foundation",
    title: "Learning to investigate.",
    text: "I began studying physics at UFRGS, where I also took part in undergraduate research. Working with computational physics, statistical mechanics, and programming taught me to formulate questions, test assumptions, and treat uncertainty as part of the work.",
  },
  {
    phase: "International contexts",
    title: "Seeing familiar problems from different places.",
    text: "Experiences studying and working in Russia, Portugal, and Japan exposed me to different ways of organizing education, work, institutions, and everyday life. They made context—and the effort required to translate it—impossible to ignore.",
  },
  {
    phase: "Operational leadership",
    title: "From operations to responsibility.",
    text: "I later managed the family business, brought data more directly into decisions, and led its transition of ownership. That period made focus, continuity, and responsible execution more concrete than any abstract management framework could.",
  },
  {
    phase: "Data and decisions",
    title: "Applying analysis in a different arena.",
    text: "Working with data analysis in an electoral campaign provided another setting in which complex information had to be organized and translated into decisions under pressure.",
  },
  {
    phase: "Quantum technologies",
    title: "Connecting research, institutions, and markets.",
    text: "At ICTQ Foton, I lead international strategy and partnerships across scientific cooperation, positioning, funding, and market pathways. This work reflects a broader interest in how organizations prepare for technological shifts before their practical implications are fully settled.",
  },
  {
    phase: "Applied AI",
    title: "Building where technology meets operations.",
    text: "As Founder and Co-CEO of PedeAqui, I work on the evolution of an AI platform for restaurant operations. Product development, technical restructuring, and commercial validation bring the different parts of this journey into one practical problem.",
  },
];
---

<BaseLayout
  lang="en"
  title={`Journey — ${site.publicName}`}
  description={description}
  alternatePath="/pt/trajetoria/"
>
  <SiteHeader lang="en" alternatePath="/pt/trajetoria/" current="journey" />
  <main id="content" class="shell journey-page">
    <header class="journey-heading">
      <p class="eyebrow">Journey · Selected chapters</p>
      <h1>A path shaped by practice, inquiry, and changing contexts.</h1>
      <p>
        This is not a complete résumé. It traces the experiences that shaped how I connect science, technology,
        business, and international cooperation.
      </p>
    </header>

    <ol class="journey-list">
      {
        chapters.map((chapter, index) => (
          <li class="journey-entry">
            <div class="journey-marker">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{chapter.phase}</p>
            </div>
            <div class="journey-copy">
              <h2>{chapter.title}</h2>
              <p>{chapter.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <section class="journey-present" aria-labelledby="journey-present-title">
      <p class="eyebrow">The present</p>
      <h2 id="journey-present-title">The path is still being written.</h2>
      <p>
        Today, PedeAqui and ICTQ Foton are the two main fronts of my work. The notes on this site document the
        questions, decisions, and changes of mind that emerge along the way.
      </p>
      <div class="journey-actions">
        <a href={withBase("/work/")}>Explore my work <span aria-hidden="true">→</span></a>
        <a href={withBase("/notes/")}>Read the notes <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
