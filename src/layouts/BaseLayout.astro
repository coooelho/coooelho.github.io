---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  lang: "en" | "pt-BR";
  title: string;
  description: string;
  alternatePath?: string;
  robots?: string;
}

const { lang, title, description, alternatePath, robots } = Astro.props;
const isEnglish = lang === "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    {alternatePath && <link rel="alternate" hreflang={isEnglish ? "pt-BR" : "en"} href={alternatePath} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{isEnglish ? "Skip to content" : "Pular para o conteúdo"}</a>
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
