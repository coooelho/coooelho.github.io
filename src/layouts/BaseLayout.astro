---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/paths";

interface Props {
  lang: "en" | "pt-BR";
  title: string;
  description: string;
  alternatePath?: string;
  robots?: string;
}

const { lang, title, description, alternatePath, robots } = Astro.props;
const isEnglish = lang === "en";
const feedPath = withBase(isEnglish ? "/rss.xml" : "/pt/rss.xml");
const alternateUrl = alternatePath ? withBase(alternatePath) : undefined;
const canonicalUrl = Astro.site ? new URL(withBase(Astro.url.pathname), Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={isEnglish ? "pt-BR" : "en"} href={alternateUrl} />}
    <link rel="alternate" type="application/rss+xml" title={isEnglish ? "Applied Frontier" : "Fronteira Aplicada"} href={feedPath} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{isEnglish ? "Skip to content" : "Pular para o conteúdo"}</a>
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
