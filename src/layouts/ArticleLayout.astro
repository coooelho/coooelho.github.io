---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
import { getCategoryLabel, getFormatLabel, getNoteDate } from "../lib/notes";
import { withBase } from "../lib/paths";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  note: CollectionEntry<"notes">;
  alternatePath: string;
}

const { note, alternatePath } = Astro.props;
const { Content } = await render(note);
const isEnglish = note.data.language === "en";
const archivePath = withBase(isEnglish ? "/notes/" : "/pt/notas/");
const sourceLabel = isEnglish ? "Sources" : "Fontes";
const normalizeReadingId = (value: string) => value.replace(/\.json$/, "");
const readingEntries = note.data.readingId ? await getCollection("reading") : [];
const readingEntry = note.data.readingId
  ? readingEntries.find((entry) => normalizeReadingId(entry.id) === normalizeReadingId(note.data.readingId!))
  : undefined;
const readingTypeLabels = isEnglish
  ? {
      book: "Book",
      paper: "Research paper",
      article: "Article",
      "conference-paper": "Conference paper",
    }
  : {
      book: "Livro",
      paper: "Artigo científico",
      article: "Artigo",
      "conference-paper": "Artigo de conferência",
    };
const publicationLabel = (year: number, approximate: boolean) => {
  const prefix = approximate ? "c. " : "";
  if (year >= 0) return `${prefix}${year}`;
  return `${prefix}${Math.abs(year)} ${isEnglish ? "BCE" : "a.C."}`;
};
const creatorText = readingEntry?.data.creators.join(", ");
---

<BaseLayout
  lang={note.data.language}
  title={`${note.data.title} — ${site.publicName}`}
  description={note.data.description}
  alternatePath={alternatePath}
>
  <SiteHeader lang={note.data.language} alternatePath={alternatePath} current="notes" />
  <main id="content" class="shell article-page">
    <a class="article-back" href={archivePath}>← {isEnglish ? "All notes" : "Todas as notas"}</a>
    <header class="article-header">
      <p class="eyebrow">{getCategoryLabel(note)} · {getFormatLabel(note)}</p>
      <h1>{note.data.title}</h1>
      <p class="article-description">{note.data.description}</p>
      <div class="article-dates">
        <time datetime={note.data.publishedAt.toISOString()}>{getNoteDate(note)}</time>
        {
          note.data.updatedAt && (
            <span>
              {isEnglish ? "Updated" : "Atualizado em"} {note.data.updatedAt.toLocaleDateString(note.data.language, {
                dateStyle: "long",
                timeZone: "UTC",
              })}
            </span>
          )
        }
      </div>
    </header>

    {
      note.data.heroImage && (
        <figure class="article-hero-image">
          <Image
            src={note.data.heroImage}
            alt={note.data.heroImageAlt ?? ""}
            widths={[720, 1080, 1440]}
            sizes="(max-width: 900px) calc(100vw - 40px), 900px"
          />
        </figure>
      )
    }

    {
      readingEntry && (
        <aside class="reading-source-card" aria-labelledby="reading-source-title">
          <p class="eyebrow">{isEnglish ? "About the work" : "Sobre a obra"}</p>
          <h2 id="reading-source-title">
            {isEnglish ? readingEntry.data.title : (readingEntry.data.titlePt ?? readingEntry.data.title)}
          </h2>
          <p class="reading-source-creator">
            {readingEntry.data.creatorRole === "editor" && (isEnglish ? "Edited by " : "Organização: ")}
            {creatorText}
          </p>
          <p class="reading-source-meta">
            {readingTypeLabels[readingEntry.data.type]} · {publicationLabel(
              readingEntry.data.publicationYear,
              readingEntry.data.publicationYearApproximate,
            )}
            {readingEntry.data.venue && ` · ${readingEntry.data.venue}`}
          </p>
          <p>{isEnglish ? readingEntry.data.description.en : readingEntry.data.description.pt}</p>
          <a href={readingEntry.data.sourceUrl} target="_blank" rel="noopener noreferrer">
            {isEnglish ? "View original source" : "Ver fonte original"} <span aria-hidden="true">↗</span>
          </a>
        </aside>
      )
    }

    <article class="article-body">
      <Content />
    </article>

    {
      note.data.disclosure && (
        <aside class="article-disclosure">
          <strong>{isEnglish ? "Disclosure" : "Transparência"}</strong>
          <p>{note.data.disclosure}</p>
        </aside>
      )
    }

    {
      note.data.sources.length > 0 && (
        <section class="article-sources" aria-labelledby="article-sources-title">
          <h2 id="article-sources-title">{sourceLabel}</h2>
          <ol>
            {note.data.sources.map((source) => (
              <li><a href={source} rel="noreferrer">{new URL(source).hostname.replace(/^www\./, "")}</a></li>
            ))}
          </ol>
        </section>
      )
    }
  </main>
</BaseLayout>
