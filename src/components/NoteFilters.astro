---
import { withBase } from "../lib/paths";

interface Props {
  lang: "en" | "pt-BR";
  current?: "all" | "research" | "business";
}

const { lang, current = "all" } = Astro.props;
const isEnglish = lang === "en";
const links = isEnglish
  ? [
      { value: "all", label: "All", href: "/notes/" },
      { value: "research", label: "Research", href: "/notes/research/" },
      { value: "business", label: "Business", href: "/notes/business/" },
    ]
  : [
      { value: "all", label: "Todas", href: "/pt/notas/" },
      { value: "research", label: "Pesquisa", href: "/pt/notas/pesquisa/" },
      { value: "business", label: "Negócios", href: "/pt/notas/negocios/" },
    ];
---

<nav class="category-nav" aria-label={isEnglish ? "Browse notes by subject" : "Explorar notas por assunto"}>
  {
    links.map((link) => (
      <a href={withBase(link.href)} aria-current={current === link.value ? "page" : undefined}>{link.label}</a>
    ))
  }
</nav>
