---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import WorkFilters from "./WorkFilters.astro";
import TopicTags from "./TopicTags.astro";
import { site } from "../config/site";
import { getFormatLabel, getNoteDate, getNotePath } from "../lib/notes";

interface Props {
  lang: "en" | "pt-BR";
  category: "pedeaqui" | "foton";
}

const { lang, category } = Astro.props;
const isEnglish = lang === "en";
const notes = (await getCollection(
  "notes",
  ({ data }) => !data.draft && data.language === lang && (data.category === category || data.tags.includes(category)),
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const copy = isEnglish
  ? {
      pedeaqui: {
        title: "PedeAqui",
        eyebrow: "Work · PedeAqui",
        description: "Notes and articles from building PedeAqui: product, technology, restaurant operations, and business validation.",
        empty: "The first PedeAqui articles are being prepared.",
      },
      foton: {
        title: "ICTQ Foton",
        eyebrow: "Work · ICTQ Foton",
        description: "Notes from my work with quantum technologies, international cooperation, strategy, and partnerships.",
        empty: "The first ICTQ Foton articles are being prepared.",
      },
    }
  : {
      pedeaqui: {
        title: "PedeAqui",
        eyebrow: "Trabalhos · PedeAqui",
        description: "Notas e artigos da construção do PedeAqui: produto, tecnologia, operação de restaurantes e validação de negócio.",
        empty: "Os primeiros artigos sobre o PedeAqui estão sendo preparados.",
      },
      foton: {
        title: "ICTQ Foton",
        eyebrow: "Trabalhos · ICTQ Foton",
        description: "Notas da minha atuação com tecnologias quânticas, cooperação internacional, estratégia e parcerias.",
        empty: "Os primeiros artigos sobre o ICTQ Foton estão sendo preparados.",
      },
    };
const page = copy[category];
const alternatePath = isEnglish
  ? `/pt/atuacao/${category}/`
  : `/work/${category}/`;
---

<BaseLayout lang={lang} title={`${page.title} — ${site.publicName}`} description={page.description} alternatePath={alternatePath}>
  <SiteHeader lang={lang} alternatePath={alternatePath} current="work" />
  <main id="content" class="shell archive">
    <header class="archive-heading">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p>{page.description}</p>
    </header>
    <WorkFilters lang={lang} current={category} />
    <div class="archive-list">
      {
        notes.length > 0 ? (
          notes.map((note) => (
            <article class="archive-item archive-item-with-topics">
              <p>{getFormatLabel(note)}</p>
              <h2><a href={getNotePath(note)}>{note.data.title}</a></h2>
              <p>{note.data.description}</p>
              <TopicTags note={note} />
              <time datetime={note.data.publishedAt.toISOString()}>{getNoteDate(note)}</time>
            </article>
          ))
        ) : (
          <p class="empty-state">{page.empty}</p>
        )
      }
    </div>
  </main>
</BaseLayout>
