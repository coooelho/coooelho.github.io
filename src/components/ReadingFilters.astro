---
import { withBase } from "../lib/paths";

interface Props {
  lang: "en" | "pt-BR";
  current?: "all" | "books" | "articles";
}

const { lang, current = "all" } = Astro.props;
const isEnglish = lang === "en";
const links = isEnglish
  ? [
      { value: "all", label: "All", href: "/reading/" },
      { value: "books", label: "Books", href: "/reading/books/" },
      { value: "articles", label: "Articles", href: "/reading/articles/" },
    ]
  : [
      { value: "all", label: "Todas", href: "/pt/leituras/" },
      { value: "books", label: "Livros", href: "/pt/leituras/livros/" },
      { value: "articles", label: "Artigos", href: "/pt/leituras/artigos/" },
    ];
---

<nav class="category-nav" aria-label={isEnglish ? "Browse reading by type" : "Explorar leituras por tipo"}>
  {
    links.map((link) => (
      <a href={withBase(link.href)} aria-current={current === link.value ? "page" : undefined}>{link.label}</a>
    ))
  }
</nav>
