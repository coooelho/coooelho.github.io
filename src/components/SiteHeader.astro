---
import { site } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  lang: "en" | "pt-BR";
  alternatePath: string;
  current?: "notes" | "reading" | "work" | "journey" | "about";
}

const { lang, alternatePath, current } = Astro.props;
const isEnglish = lang === "en";
const selfPath = Astro.url.pathname;
const links = isEnglish
  ? [
      { key: "work", label: "Work", href: "/work/" },
      { key: "notes", label: "Notes", href: "/notes/" },
      { key: "reading", label: "Reading", href: "/reading/" },
      { key: "journey", label: "Journey", href: "/journey/" },
      { key: "about", label: "About", href: "/about/" },
    ]
  : [
      { key: "work", label: "Trabalhos", href: "/pt/atuacao/" },
      { key: "notes", label: "Notas", href: "/pt/notas/" },
      { key: "reading", label: "Leituras", href: "/pt/leituras/" },
      { key: "journey", label: "Trajetória", href: "/pt/trajetoria/" },
      { key: "about", label: "Sobre", href: "/pt/sobre/" },
    ];
---

<header class="site-header shell">
  <a class="brand" href={withBase(isEnglish ? "/" : "/pt/")}>{site.publicName}</a>
  <nav class="primary-nav" aria-label={isEnglish ? "Main navigation" : "Navegação principal"}>
    {
      links.map((link) => (
        <a href={withBase(link.href)} aria-current={current === link.key ? "page" : undefined}>{link.label}</a>
      ))
    }
  </nav>
  <nav class="language-nav" aria-label={isEnglish ? "Language" : "Idioma"}>
    <a href={withBase(isEnglish ? alternatePath : selfPath)} lang="pt-BR" aria-current={!isEnglish ? "page" : undefined}>PT</a>
    <span aria-hidden="true">/</span>
    <a href={withBase(isEnglish ? selfPath : alternatePath)} lang="en" aria-current={isEnglish ? "page" : undefined}>EN</a>
  </nav>
</header>
